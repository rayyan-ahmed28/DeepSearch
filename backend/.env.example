# Copy to .env and fill in what you have. Every key may stay blank:
# the app must run end-to-end in Demo Mode with zero keys set.
# (Comments sit on their own lines so a blank value is never misread.)

# ── LLM Provider ─────────────────────────────────────────────────
# gemini | openai | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model for Router, Managers, Verification and Report Architect.
# Google's recommendation for new projects (Oct 2026): gemini-3.5-flash-lite
# or gemini-3.8-flash. Check which your free tier allows in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# GPT Researcher (our Web Research Worker backbone) reads its OWN env
# vars, independent of LLM_PROVIDER/GEMINI_API_KEY above. Point them
# at the same Gemini key, or it will silently try its packaged
# default (xai:grok-4.3) and fail with no xAI key configured.
FAST_LLM=google_genai:gemini-3.5-flash-lite
SMART_LLM=google_genai:gemini-3.5-flash-lite
STRATEGIC_LLM=google_genai:gemini-3.5-flash-lite
# Same value as GEMINI_API_KEY above.
GOOGLE_API_KEY=
# Overrides GPT Researcher's default local HuggingFace embedding (needs
# torch, not in our requirements). text-embedding-004 was shut down on
# 2026-01-14; gemini-embedding-001 is supported until May 2028.
EMBEDDING=google_genai:models/gemini-embedding-001

# ── Web research ─────────────────────────────────────────────────
# Optional: falls back to keyless DuckDuckGo search if blank (D2).
TAVILY_API_KEY=

# ── Legal data ───────────────────────────────────────────────────
# Optional but recommended; free EDU tier with a college email (D4).
COURTLISTENER_API_TOKEN=

# ── Finance data ─────────────────────────────────────────────────
# yfinance and SEC EDGAR need no key, but SEC policy requires a
# descriptive User-Agent with a contact address.
SEC_EDGAR_USER_AGENT="DeepSearch College Project <you@example.edu>"

# ── App behavior ─────────────────────────────────────────────────
# auto | true | false  (auto = live only when the needed keys exist)
DEMO_MODE=auto
DATABASE_URL=sqlite:///./deepsearch.db
CORS_ORIGINS=http://localhost:5173
