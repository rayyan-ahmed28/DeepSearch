# ── LLM Provider ─────────────────────────────────────────────────
# Leave GEMINI_API_KEY blank to force Demo Mode. The app must run
# fully end-to-end with zero keys set below.
LLM_PROVIDER=gemini              # gemini | openai | none
GEMINI_API_KEY=

# GPT Researcher (our Web Research Worker backbone) reads its OWN env
# vars, independent of LLM_PROVIDER/GEMINI_API_KEY above. Point them
# at the same Gemini key, or it will silently try its packaged
# default (xai:grok-4.3) and fail with no xAI key configured.
FAST_LLM=google_genai:gemini-2.0-flash
SMART_LLM=google_genai:gemini-2.0-flash
STRATEGIC_LLM=google_genai:gemini-2.0-flash
GOOGLE_API_KEY=                  # same value as GEMINI_API_KEY above
# Overrides GPT Researcher's default local HuggingFace embedding
# (which needs torch/sentence-transformers, not in our requirements)
# with a small free-tier API call instead — keeps the install light.
EMBEDDING=google_genai:models/text-embedding-004

# ── Web research (optional — falls back to keyless DuckDuckGo search
#    if blank; see D2) ───────────────────────────────────────────
TAVILY_API_KEY=

# ── Legal data (optional but recommended; free EDU tier available
#    with a college email — see D4) ───────────────────────────────
COURTLISTENER_API_TOKEN=

# ── Finance data — yfinance needs no key; SEC EDGAR needs no key
#    but requires a descriptive User-Agent per SEC policy ─────────
SEC_EDGAR_USER_AGENT="DeepSearch College Project <you@example.edu>"

# ── App behavior ─────────────────────────────────────────────────
DEMO_MODE=auto                   # auto | true | false
DATABASE_URL=sqlite:///./deepsearch.db
CORS_ORIGINS=http://localhost:5173
